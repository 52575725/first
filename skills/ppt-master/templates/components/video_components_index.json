{
  "meta": {
    "name": "PPT Master video component library",
    "version": "2026-05-13",
    "default_viewbox": "1920 1080",
    "purpose": "Reusable component choices for PPT-to-video recomposition and LLM layout selection.",
    "selection_rule": "Pick the component whose content_shape matches the slide/paragraph structure. Prefer image components only when the visual adds evidence or emotional context."
  },
  "categories": {
    "narrative": {
      "label": "Narrative",
      "components": [
        "preserve_slide",
        "cover_hero",
        "section_title",
        "statement_focus",
        "quote_focus"
      ]
    },
    "content": {
      "label": "Content Explanation",
      "components": [
        "insight_cards",
        "problem_stack",
        "solution_flow",
        "capability_matrix",
        "before_after",
        "dense_grid",
        "split_text_visual"
      ]
    },
    "process": {
      "label": "Process and Roadmap",
      "components": [
        "process_flow",
        "timeline",
        "roadmap_timeline",
        "lifecycle_loop",
        "flywheel"
      ]
    },
    "data": {
      "label": "Data and Business",
      "components": [
        "metric_dashboard",
        "kpi_cards",
        "chart_focus",
        "market_dashboard",
        "revenue_model",
        "financial_snapshot"
      ]
    },
    "visual": {
      "label": "Visual Evidence",
      "components": [
        "image_hero",
        "image_pan_zoom",
        "photo_story",
        "image_mosaic",
        "product_showcase",
        "map_focus"
      ]
    },
    "people": {
      "label": "People and Organization",
      "components": [
        "team_roster",
        "role_grid",
        "org_chart"
      ]
    }
  },
  "components": {
    "preserve_slide": {
      "name": "Preserve original slide",
      "content_shape": ["visually complete slides", "dense imported PPT", "slides with strong existing composition"],
      "best_for": ["finished PPT pages", "OCR-derived source decks", "slides where recomposition may lose visual meaning"],
      "visual_treatment": "keep original slide as base, add subtle spotlight or callout only",
      "video_treatment": "stable hold with small emphasis animation",
      "needs_image": false
    },
    "cover_hero": {
      "name": "Editorial cover hero",
      "content_shape": ["cover", "opening statement", "brand or project title"],
      "best_for": ["low-density title slides", "project introductions", "vision statements"],
      "visual_treatment": "large title, one strong visual or emblem, restrained accent line",
      "video_treatment": "slow entrance, no card frame",
      "needs_image": "optional"
    },
    "section_title": {
      "name": "Section title",
      "content_shape": ["chapter divider", "transition slide", "single idea"],
      "best_for": ["low text density", "agenda transitions"],
      "visual_treatment": "big title, short subtitle, clear whitespace",
      "video_treatment": "fade in title and underline",
      "needs_image": false
    },
    "statement_focus": {
      "name": "Statement focus",
      "content_shape": ["one core claim", "executive summary", "single takeaway"],
      "best_for": ["insight headline with one support sentence"],
      "visual_treatment": "one oversized statement with compact evidence strip",
      "video_treatment": "claim first, support appears second",
      "needs_image": false
    },
    "quote_focus": {
      "name": "Quote or voiceover focus",
      "content_shape": ["quote", "testimonial", "mission sentence"],
      "best_for": ["speaker-driven paragraphs", "customer voice", "founder message"],
      "visual_treatment": "large quote block, source line, minimal background",
      "video_treatment": "type-on or fade by phrase",
      "needs_image": "optional"
    },
    "insight_cards": {
      "name": "Modern insight cards",
      "content_shape": ["3-5 parallel points", "feature list", "benefit list"],
      "best_for": ["clean bullet groups", "three-card summaries", "advantage pages"],
      "visual_treatment": "flat white cards, color-coded accent bars, no debug-like borders",
      "video_treatment": "card-by-card reveal",
      "needs_image": false
    },
    "problem_stack": {
      "name": "Problem stack",
      "content_shape": ["pain points", "risks", "barriers", "challenge decomposition"],
      "best_for": ["problem pages", "market friction", "operational bottlenecks"],
      "visual_treatment": "2x2 or vertical stack with severity colors and concise evidence",
      "video_treatment": "problems appear in order of narration",
      "needs_image": false
    },
    "solution_flow": {
      "name": "Solution flow",
      "content_shape": ["solution steps", "workflow", "closed-loop chain"],
      "best_for": ["3-7 connected stages", "from source to outcome"],
      "template": "process_flow.svg",
      "visual_treatment": "horizontal path with numbered nodes and final outcome",
      "video_treatment": "advance along the path",
      "needs_image": false
    },
    "capability_matrix": {
      "name": "Capability matrix",
